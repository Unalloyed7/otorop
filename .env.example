# Значения API и точные ID моделей выдаются организаторами.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Альтернативы: OPENAI_BASE_URL, OPENAI_API_KEY, OPENAI_MODEL или GEN_MODEL.
EMB_MODEL=
RERANKER_MODEL=
DATA_DIR=data
TEMPERATURE=0
MAX_TOKENS=2500
MAX_WORKERS=2
API_TIMEOUT=60
API_RETRIES=2
QUESTION_TIMEOUT=240
SEARCH_RETRIES=1
MAX_MODEL_CALLS=6
MAX_SEARCH_CALLS=3
# WEB_STATE_DIR=.state
RUN_TIMEOUT=1120
TOP_K=12
RERANKER_TOP_N=8
VERIFY_ANSWER=1
# Подключение участника №1: корневой модуль и фабрика, например retrieval:create_search
SEARCH_FACTORY=retrieval:create_search
# CHUNKER из платформы передаётся окружением; обрабатывается поиском №1.
# Локальный порт веб-интерфейса Docker Compose.
WEB_PORT=8000

# Конвейер №1: необязательные настройки; генеративное извлечение не включается автоматически.
# OTOROP_KNOWLEDGE_CACHE_DIR=.state/knowledge
# KNOWLEDGE_LLM_EXTRACTION=0
# KNOWLEDGE_RELATION_REVIEW=0
